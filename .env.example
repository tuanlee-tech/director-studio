# ==============================================
# AI Audio Platform - Environment Configuration
# ==============================================

# --- Shared ---
COMPOSE_PROJECT_NAME=ai-audio-platform
HF_HOME=/home/app/.cache/huggingface
# HF_TOKEN=hf_...

# --- VieNeu TTS ---
VIENEU_PORT=7860
VIENEU_API_PORT=8000
VIENEU_BACKEND=auto
VIENEU_PRECISION=fp32
VIENEU_MAX_STREAMS=4
VIENEU_QUEUE=4
VIENEU_QUEUE_TIMEOUT=10
# VIENEU_API_KEY=
# VIENEU_WEB_AUTH=admin:change-this-password
VIENEU_WATERMARK=0

# --- Studio UI ---
STUDIO_PORT=3000

